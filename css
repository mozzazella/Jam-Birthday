<style>

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
}

body {
    min-height: 100vh;

    background-image: url("background.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;

    font-family: Arial, sans-serif;
    color: #40566b;

    padding: 25px 12px;
}


/* MESSAGE BOX */

.message-box {
    width: 100%;
    max-width: 650px;

    margin: 0 auto;

    background: rgba(255, 255, 255, 0.95);

    padding: 30px 25px 40px 25px;

    border-radius: 25px;

    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);

    overflow: visible;
}


/* TITLE */

h1 {
    text-align: center;

    color: #428dcc;

    font-size: 30px;

    margin: 0 0 25px 0;
}


/* MESSAGE */

p {
    font-size: 16px;

    line-height: 1.8;

    text-align: left;

    margin: 0;
}


/* MUSIC PLAYER */

audio {
    display: block;

    width: 100%;

    margin-top: 30px;

    margin-bottom: 0;

    /* DON'T FORCE A HEIGHT */
    height: auto;

    min-height: 54px;
}


/* PHONE */

@media (max-width: 600px) {

    body {
        padding: 15px 10px;
    }

    .message-box {
        width: 100%;

        padding: 25px 20px 40px 20px;

        border-radius: 20px;
    }

    h1 {
        font-size: 26px;
    }

    p {
        font-size: 15px;

        line-height: 1.7;
    }

    audio {
        width: 100%;

        min-height: 54px;

        margin-top: 25px;
    }

}

</style>
