body {
    margin: 0;
    padding: 30px 15px;

    min-height: 100vh;

    background-image: url("background.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;

    font-family: Arial, sans-serif;
    color: #40566b;
}

.message-box {
    width: 100%;
    max-width: 650px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.95);
    padding: 30px;
    border-radius: 25px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
}

h1 {
    text-align: center;
    color: #428dcc;
}

p {
    font-size: 16px;
    line-height: 1.7;
}

audio {
    display: block;
    width: 100%;
    height: 45px;
    margin-top: 25px;
    margin-bottom: 5px;
}
